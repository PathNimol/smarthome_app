{
  "rules": {

    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────
    "users": {
      "$uid": {
        // Owner or admin can read/write their profile
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['email', 'role', 'createdAt'])",
        "email":     { ".validate": "newData.isString() && newData.val().contains('@')" },
        "role":      { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'user' || newData.val() === 'viewer')" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeen":  { ".validate": "newData.isNumber()" },
        "fcmTokens": {
          "$tokenId": {
            ".validate": "newData.isString()"
          }
        },
        "$other": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────
    // DEVICES
    // ─────────────────────────────────────────────
    "devices": {
      "$deviceId": {
        // Any authenticated user can read devices; only admin/device-owner can write
        ".read":  "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('devices').child($deviceId).child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'type', 'ownerId', 'status'])",
        "name":      { ".validate": "newData.isString() && newData.val().length <= 100" },
        "type":      { ".validate": "newData.isString()" },
        "ownerId":   { ".validate": "newData.isString()" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')" },
        "lastPing":  { ".validate": "newData.isNumber()" },
        "location":  { ".validate": "newData.isString()" },
        "authToken": {
          // Only admins can read the raw device token
          ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "$other": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────
    // SENSORS  (high-frequency writes from ESP32)
    // ─────────────────────────────────────────────
    "sensors": {
      "$deviceId": {
        ".read": "auth != null",
        // Device writes via custom token validated in Cloud Functions
        ".write": "auth != null",

        "water_level": {
          ".validate": "newData.hasChildren(['value', 'unit', 'timestamp'])",
          "value":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "unit":      { ".validate": "newData.isString()" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "status":    { ".validate": "newData.isString()" },
          "$other":    { ".validate": false }
        },

        "rain_status": {
          ".validate": "newData.hasChildren(['isRaining', 'intensity', 'timestamp'])",
          "isRaining":  { ".validate": "newData.isBoolean()" },
          "intensity":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "timestamp":  { ".validate": "newData.isNumber()" },
          "rawValue":   { ".validate": "newData.isNumber()" },
          "$other":     { ".validate": false }
        },

        "temperature": {
          ".validate": "newData.hasChildren(['value', 'timestamp'])",
          "value":     { ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 85" },
          "unit":      { ".validate": "newData.isString()" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        },

        "humidity": {
          ".validate": "newData.hasChildren(['value', 'timestamp'])",
          "value":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "unit":      { ".validate": "newData.isString()" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other":    { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────
    // RELAY STATES  (fan / light control)
    // ─────────────────────────────────────────────
    "relay_states": {
      "$deviceId": {
        ".read":  "auth != null",
        ".write": "auth != null",

        "$relayId": {
          ".validate": "newData.hasChildren(['state', 'updatedAt', 'updatedBy'])",
          "state":      { ".validate": "newData.isBoolean()" },
          "label":      { ".validate": "newData.isString() && newData.val().length <= 50" },
          "updatedAt":  { ".validate": "newData.isNumber()" },
          "updatedBy":  { ".validate": "newData.isString()" },
          "autoMode":   { ".validate": "newData.isBoolean()" },
          "$other":     { ".validate": false }
        }
      }
    },

    // ─────────────────────────────────────────────
    // NOTIFICATIONS  (read-only for end users)
    // ─────────────────────────────────────────────
    "notifications": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "$notifId": {
          ".validate": "newData.hasChildren(['type', 'title', 'body', 'timestamp'])",
          "type":      { ".validate": "newData.isString()" },
          "title":     { ".validate": "newData.isString() && newData.val().length <= 100" },
          "body":      { ".validate": "newData.isString() && newData.val().length <= 500" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "read":      { ".validate": "newData.isBoolean()" },
          "deviceId":  { ".validate": "newData.isString()" },
          "data":      {},
          "$other":    { ".validate": false }
        }
      }
    },

    // ─────────────────────────────────────────────
    // ACTIVITY LOGS  (append-only audit trail)
    // ─────────────────────────────────────────────
    "activity_logs": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null",
      "$logId": {
        ".validate": "newData.hasChildren(['action', 'userId', 'timestamp'])",
        "action":    { ".validate": "newData.isString()" },
        "userId":    { ".validate": "newData.isString()" },
        "deviceId":  { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "details":   {},
        "$other":    { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────
    // SENSOR HISTORY  (time-series snapshots)
    // ─────────────────────────────────────────────
    "sensor_history": {
      "$deviceId": {
        ".read":  "auth != null",
        ".write": "auth != null",
        "$sensorType": {
          "$timestamp": {
            ".validate": "newData.hasChildren(['value', 'timestamp'])"
          }
        }
      }
    },

    // Block everything else
    "$other": { ".read": false, ".write": false }
  }
}
