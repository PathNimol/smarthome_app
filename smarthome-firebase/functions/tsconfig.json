{
  "compilerOptions": {
    "module":           "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals":   true,
    "outDir":           "lib",
    "sourceMap":        true,
    "strict":           true,
    "target":           "es2017",
    "esModuleInterop":  true,
    "resolveJsonModule": true,
    "skipLibCheck":     true,
    "baseUrl":          "./src",
    "paths": {
      "@config/*":        ["config/*"],
      "@services/*":      ["services/*"],
      "@middleware/*":    ["middleware/*"],
      "@utils/*":         ["utils/*"],
      "@notifications/*": ["notifications/*"],
      "@triggers/*":      ["triggers/*"]
    }
  },
  "compileOnSave": true,
  "include": ["src"]
}
