# ─────────────────────────────────────────────────────────────
# Smart Home IoT Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# Firebase Project
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Admin SDK Service Account (base64-encoded JSON)
# Generate: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=your-fcm-server-key

# Device Authentication Secret (used to sign ESP32 tokens)
DEVICE_SECRET=change-this-to-a-long-random-secret-32chars+

# Sensor Thresholds
WATER_LEVEL_WARNING_THRESHOLD=70
WATER_LEVEL_CRITICAL_THRESHOLD=90
RAIN_INTENSITY_THRESHOLD=30

# Function Config
NODE_ENV=production
LOG_LEVEL=info

# Emulator (local dev only)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
